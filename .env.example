# Public URL of the site (used in share links, OG tags and the admin generator).
# Leave empty locally: the admin page then uses the current browser origin.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. When set, /admin asks for this password (httpOnly signed cookie, 60 days).
# When empty, /admin is open. It never exposes guest data (there is no database),
# but anyone could then create invitation links, so set it in production.
ADMIN_PASSWORD=
